# jemdoc: menu{MENU}{seen.html}, title{Seen}

= Seen

# Each section = a photo frame (with < > arrows and a 1 / 4 counter on it) + a caption line.
# Photos: figs/seen/<section>/1.jpg, 2.jpg, ...  Captions: captions.txt in the same folder, one line per photo.

== Field
~~~
{}{raw}
<!-- data-folder: where this slideshow's photos live; max-width: frame size; aspect-ratio: frame shape -->
<div class="slideframe" data-folder="figs/seen/field/"
     style="width:100%; max-width:300px; aspect-ratio:4/3; background-color:#ede8de; background-size:contain; background-position:center; background-repeat:no-repeat; border-radius:6px; cursor:pointer; position:relative;">
  <a href="#" class="prev" style="left:8px; position:absolute; top:50%; transform:translateY(-50%); width:28px; height:28px; line-height:26px; text-align:center; border-radius:50%; background:rgba(245,242,235,0.8); color:#2c2a24; font-size:20px; text-decoration:none; border:none;">&lsaquo;</a>
  <a href="#" class="next" style="right:8px; position:absolute; top:50%; transform:translateY(-50%); width:28px; height:28px; line-height:26px; text-align:center; border-radius:50%; background:rgba(245,242,235,0.8); color:#2c2a24; font-size:20px; text-decoration:none; border:none;">&rsaquo;</a>
  <span class="count" style="position:absolute; top:8px; right:8px; padding:1px 8px; border-radius:10px; background:rgba(245,242,235,0.8); color:#2c2a24; font-size:0.8em;"></span>
</div>
<p class="slidecap" style="margin:0.4em 0 0; white-space:nowrap;"></p>
~~~

== Archive
~~~
{}{raw}
<div class="slideframe" data-folder="figs/seen/archive/"
     style="width:100%; max-width:300px; aspect-ratio:4/3; background-color:#ede8de; background-size:contain; background-position:center; background-repeat:no-repeat; border-radius:6px; cursor:pointer; position:relative;">
  <a href="#" class="prev" style="left:8px; position:absolute; top:50%; transform:translateY(-50%); width:28px; height:28px; line-height:26px; text-align:center; border-radius:50%; background:rgba(245,242,235,0.8); color:#2c2a24; font-size:20px; text-decoration:none; border:none;">&lsaquo;</a>
  <a href="#" class="next" style="right:8px; position:absolute; top:50%; transform:translateY(-50%); width:28px; height:28px; line-height:26px; text-align:center; border-radius:50%; background:rgba(245,242,235,0.8); color:#2c2a24; font-size:20px; text-decoration:none; border:none;">&rsaquo;</a>
  <span class="count" style="position:absolute; top:8px; right:8px; padding:1px 8px; border-radius:10px; background:rgba(245,242,235,0.8); color:#2c2a24; font-size:0.8em;"></span>
</div>
<p class="slidecap" style="margin:0.4em 0 0; white-space:nowrap;"></p>
<!-- This script runs BOTH slideshows (Field and Archive) -->
<script>
document.querySelectorAll(".slideframe").forEach(function (frame) {
  var folder = frame.dataset.folder;
  var cap = frame.nextElementSibling, count = frame.querySelector(".count");
  var urls = [], caps = [], i = 0;
  // Show photo number i (with its caption and "2 / 4" counter)
  function show() {
    if (!urls.length) return;
    frame.style.backgroundImage = "url('" + urls[i] + "')";
    cap.textContent = caps[i] || "";
    count.textContent = (i + 1) + " / " + urls.length;
  }
  // Arrows: previous / next, wrapping around at the ends
  frame.querySelector(".prev").onclick = function (e) { e.preventDefault(); e.stopPropagation(); i = (i - 1 + urls.length) % urls.length; show(); };
  frame.querySelector(".next").onclick = function (e) { e.preventDefault(); e.stopPropagation(); i = (i + 1) % urls.length; show(); };
  // Click a photo to open it full size
  frame.onclick = function () { if (urls.length) window.open(urls[i], "_blank"); };
  // Load captions.txt
  fetch(folder + "captions.txt", {cache: "no-cache"})
    .then(function (r) { return r.ok ? r.text() : ""; })
    .then(function (t) { caps = t.split(/\r?\n/); show(); })
    .catch(function () {});
  // Find 1.jpg, 2.jpg, ... until one is missing
  function find(k) {
    var img = new Image();
    img.onload = function () { urls.push(folder + k + ".jpg"); if (k === 1) show(); else count.textContent = (i + 1) + " / " + urls.length; find(k + 1); };
    img.src = folder + k + ".jpg";
  }
  find(1);
});
</script>
~~~
