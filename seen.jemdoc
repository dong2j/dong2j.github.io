# jemdoc: menu{MENU}{seen.html}, title{Seen}

= Seen

# Each section = a photo frame + a caption line.
# Photos: figs/seen/<section>/1.jpg, 2.jpg, ...  Captions: captions.txt in the same folder, one line per photo.

== Field
~~~
{}{raw}
<!-- data-folder: where this slideshow's photos live; max-width: frame size; aspect-ratio: frame shape -->
<div class="slideframe" data-folder="figs/seen/field/"
     style="width:100%; max-width:300px; aspect-ratio:4/3; background-color:#ede8de; background-size:contain; background-position:center; background-repeat:no-repeat; border-radius:6px; cursor:pointer;"></div>
<p class="slidecap" style="max-width:300px; margin:0.4em 0 0;"></p>
~~~

== Archive
~~~
{}{raw}
<div class="slideframe" data-folder="figs/seen/archive/"
     style="width:100%; max-width:300px; aspect-ratio:4/3; background-color:#ede8de; background-size:contain; background-position:center; background-repeat:no-repeat; border-radius:6px; cursor:pointer;"></div>
<p class="slidecap" style="max-width:300px; margin:0.4em 0 0;"></p>
<!-- This script runs BOTH slideshows (Field and Archive) -->
<script>
document.querySelectorAll(".slideframe").forEach(function (frame) {
  var folder = frame.dataset.folder, n = 1, current = "", caps = [];
  var cap = frame.nextElementSibling;
  // Load captions.txt
  fetch(folder + "captions.txt", {cache: "no-cache"})
    .then(function (r) { return r.ok ? r.text() : ""; })
    .then(function (t) { caps = t.split(/\r?\n/); cap.textContent = caps[n - 2] || ""; })
    .catch(function () {});
  // Click a photo to open it full size
  frame.onclick = function () { if (current) window.open(current, "_blank"); };
  // Show photo k.jpg; if it doesn't exist, go back to 1.jpg
  function show(k) {
    var url = folder + k + ".jpg", probe = new Image();
    probe.onload = function () {
      current = url;
      frame.style.backgroundImage = "url('" + url + "')";
      cap.textContent = caps[k - 1] || "";
      n = k + 1;
    };
    probe.onerror = function () { if (k > 1) show(1); };
    probe.src = url;
  }
  show(1);
  // Next photo every 8000 ms (8 seconds)
  setInterval(function () { show(n); }, 8000);
});
</script>
~~~
